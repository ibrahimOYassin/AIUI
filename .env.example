# Copy to ".env" and adjust. Docker Compose reads ".env" automatically; never commit it.

# local = one owner, signed in automatically (your own machine only).
# web   = everyone registers and signs in; an administrator account is created on first start.
AIUI_MODE=web

# Where the containers listen on this machine.
AIUI_BIND=127.0.0.1
AIUI_WEB_PORT=4420
AIUI_API_PORT=4421

# The first administrator (web mode). Change the password after the first sign-in.
AIUI_ADMIN_EMAIL=admin@example.com
AIUI_ADMIN_PASSWORD=change-me-please

# Web addresses allowed to call the API domain from a browser.
AIUI_CORS_ORIGINS=https://aiui.example.com

# Your public address, for search engines (canonical links, sitemap, robots.txt, llms.txt).
# Used when the web image is built.
AIUI_SITE_URL=https://aiui.example.com

# Run inside the IDE executes generated code in the API container.
# Leave empty: administrators only in web mode. "true" = everyone, "false" = nobody.
# Administrators can change this later in Admin -> Settings.
AIUI_ALLOW_RUN=

# The AI Assistant's starting model (Admin -> Assistant can change it later).
# Default: Ollama's lfm3 at http://localhost:11434/v1. From inside Docker, use the Ollama
# machine's address, or http://host.docker.internal:11434/v1 for Ollama on this machine.
# Provider "openai" means any OpenAI-compatible server; "anthropic" uses Claude.
AIUI_ASSISTANT_PROVIDER=openai
AIUI_ASSISTANT_BASE_URL=http://host.docker.internal:11434/v1
AIUI_ASSISTANT_MODEL=lfm3

# Only when the images come from a registry instead of being built here.
# The prefix ends with a slash, e.g. "registry.example:5000/".
AIUI_IMAGE_PREFIX=
AIUI_TAG=0.1.0
